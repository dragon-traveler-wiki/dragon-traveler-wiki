# Copy this file to .env.local. Relative paths are resolved from the repository
# root. These defaults expect dragon-traveler-data to be cloned alongside this
# repository; update both paths if your clone is elsewhere.
DATA_DIR=../dragon-traveler-data/data
ASSETS_DIR=../dragon-traveler-data/assets

# Browser-facing asset base URL. In development, Vite serves ASSETS_DIR at
# /assets. Production CI overrides this with the public R2 URL.
VITE_ASSETS_BASE=/assets
# Community API and Cloudflare Turnstile
VITE_API_BASE_URL=http://localhost:8787
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
